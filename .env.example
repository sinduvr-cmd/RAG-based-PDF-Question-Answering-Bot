# =====================================================================
# IBM watsonx.ai Credentials Configuration
# Copy this file to .env and fill in your actual credentials.
# =====================================================================

# 1. IBM Cloud API Key:
# Obtain from IBM Cloud IAM: https://cloud.ibm.com/iam/apikeys
WATSONX_APIKEY=your_ibm_watsonx_api_key_here

# 2. watsonx.ai Project ID:
# Found in your watsonx.ai project: Project -> Manage tab -> General -> Project ID (GUID)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# 3. watsonx.ai Regional Service URL:
# Examples:
# Dallas (us-south):     https://us-south.ml.cloud.ibm.com
# Sydney (au-syd):       https://au-syd.ml.cloud.ibm.com
# Frankfurt (eu-de):     https://eu-de.ml.cloud.ibm.com
# Tokyo (jp-tok):        https://jp-tok.ml.cloud.ibm.com
# London (eu-gb):        https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# 4. Foundation Models Configuration (Optional overrides)
# Embedding model (Slate-125m dense retriever model):
WATSONX_EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr-v2

# LLM for instruction-following QA (e.g., granite-13b-chat-v2 or granite-3-8b-instruct):
WATSONX_LLM_MODEL_ID=ibm/granite-13b-chat-v2
